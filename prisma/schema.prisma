// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id
  name          String
  phoneNumber   String
  email         String
  emailVerified Boolean       @default(false)
  username      String        @unique
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  pets          Pet[]
  role          UserRole      @default(OWNER)
  appointments  Appointment[]
  scheduleBlocks ScheduleBlock[] // periods blocked by admin
  notifications Notification[]
  shopOrders    ShopOrder[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Pet {
  id String @id @default(uuid())

  // basic information
  name              String
  species           Species
  sex               Sex
  photoUrl          String?
  color             String?
  breed             String?
  dateOfBirth       DateTime?
  estimatedAgeValue Decimal?
  estimatedAgeUnit  AgeUnit?
  estimatedAgeAt    DateTime?
  lifestyle         Lifestyle?

  // medical information
  spayedNeutered    spayedNeuteredStatus?
  spayedNeuteredAt  DateTime?
  allergies         String?
  medicalConditions String?
  medications       String?
  diet              String?
  previousHistory   String?
  vaccinations      Vaccination[]
  weightRecords     WeightRecord[]
  treatments        Treatment[]
  medicalVisits     MedicalVisit[]
  appointments      Appointment[]
  careReminders     CareReminder[]
  documents         MedicalDocument[]

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("pet")
}

enum spayedNeuteredStatus {
  YES
  NO
  UNKNOWN
}

model Treatment {
  id             String          @id @default(uuid())
  type           TreatmentType
  administeredAt DateTime?
  petId          String
  careReminder   CareReminder?
  pet            Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)

  // Empty for a dose entered from registration or the pet profile.
  medicalVisitId String?
  medicalVisit   MedicalVisit? @relation(fields: [medicalVisitId], references: [id], onDelete: SetNull)

  @@index([petId])
  @@index([medicalVisitId])
  @@map("treatment")
}

model Appointment {
  id              String            @id @default(uuid())
  type            AppointmentType
  startAt         DateTime
  duration        Int // Duration in minutes
  status          AppointmentStatus @default(BOOKED)
  // Services requested for a veterinary visit. Grooming and operations leave this empty.
  services        VisitService[]    @default([])
  // Set only when type is GROOMING. Shower, haircut, or both do not change the two-hour duration.
  groomingService GroomingService?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  medicalVisit MedicalVisit?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, startAt])
  @@index([petId, startAt])
  @@index([status, startAt])
  @@map("appointment")
}

enum AppointmentType {
  VETERINARY_VISIT
  GROOMING
  OPERATION
}

enum VisitService {
  CHECKUP
  VACCINATION
  DEWORMING
  FLEA_TREATMENT
  FOLLOW_UP
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum GroomingService {
  SHOWER
  HAIRCUT
  BOTH
}

enum TreatmentType {
  DEWORMING
  FLEA_TICK
}

enum Species {
  CAT
  DOG
}

enum Sex {
  MALE
  FEMALE
}

enum Lifestyle {
  INDOOR
  OUTDOOR
  HYBRID
}

model Vaccination {
  id             String          @id @default(uuid())
  administeredAt DateTime?
  type           VaccinationType
  careReminder   CareReminder?
  petId          String
  pet            Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)

  // Empty for a dose entered from registration or the pet profile.
  medicalVisitId String?
  medicalVisit   MedicalVisit? @relation(fields: [medicalVisitId], references: [id], onDelete: SetNull)

  @@index([petId])
  @@index([medicalVisitId])
  @@map("vaccination")
}

model WeightRecord {
  id          String   @id @default(uuid())
  weightGrams Int
  recordedAt  DateTime @default(now())
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@map("weight_record")
}

enum VaccinationType {
  FIRST
  SECOND
  THIRD
  ANNUAL
}

enum UserRole {
  OWNER
  ADMIN
  SECONDARY_ADMIN
}

enum AgeUnit {
  DAYS
  WEEKS
  MONTHS
  YEARS
}

model MedicalVisit {
  id        String   @id @default(uuid())
  visitedAt DateTime
  notes     String?
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  // Empty for a walk-in. One visit note per booking.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  vaccinations Vaccination[]
  treatments   Treatment[]

  @@index([petId])
  @@map("medical_visit")
}

enum ReminderType {
  VACCINATION
  DEWORMING
  FLEA_TREATMENT
}

model ScheduleBlock {
  id        String   @id @default(uuid())
  startAt   DateTime
  endAt     DateTime
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  scope BlockScope

  @@index([startAt, endAt])
  @@map("schedule_block")
}

enum BlockScope {
  CLINIC
  GROOMING
  BOTH
}

// One open follow-up per pet and kind, enforced by care_reminder_one_open_per_kind.
// A row points at a vaccination or a treatment, not both.
model CareReminder {
  id          String       @id @default(uuid())
  kind        ReminderType
  dueAt       DateTime
  completedAt DateTime?
  // True when the vet changed the calculated date. A later dose still replaces it.
  overridden  Boolean      @default(false)
  dose        String?

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  vaccinationId String?      @unique
  vaccination   Vaccination? @relation(fields: [vaccinationId], references: [id], onDelete: Cascade)

  treatmentId String?    @unique
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([petId, kind], map: "care_reminder_one_open_per_kind", where: { completedAt: null })
  @@index([petId, dueAt])
  @@index([dueAt, completedAt])
  @@map("care_reminder")
}

model Notification {
  id        String    @id @default(uuid())
  title     String
  body      String
  readAt    DateTime?
  // Stops a retried booking or a repeated cron run from writing the same notice twice.
  dedupeKey String?   @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notification")
}

model ClinicSetting {
  id             String  @id @default("clinic")
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  mapsUrl        String?
  // Left empty until the clinic provides an after-hours emergency number. The app must not invent one.
  emergencyPhone String?
  about          String?

  @@map("clinic_setting")
}

model MedicalDocument {
  id          String   @id @default(uuid())
  title       String
  storedName  String
  contentType String

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([petId])
  @@map("medical_document")
}

model ProductCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("product_category")
}

model Product {
  id          String          @id @default(uuid())
  name        String
  description String?
  // Whole Lebanese pounds. The clinic has not asked for another currency.
  price       Int
  stock       Int             @default(0)
  photoUrl    String?
  available   Boolean         @default(true)
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId])
  @@map("product")
}

enum ShopOrderStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

model ShopOrder {
  id        String          @id @default(uuid())
  status    ShopOrderStatus @default(PENDING)
  // Payment is arranged at the clinic. This is not an online payment.
  payment   String          @default("CASH_ON_DELIVERY")

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])
  items   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@index([status])
  @@map("shop_order")
}

model OrderItem {
  id             String    @id @default(uuid())
  quantity       Int
  unitPrice      Int
  orderId        String
  order          ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_item")
}