// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id
  name          String
  phoneNumber   String
  email         String
  emailVerified Boolean       @default(false)
  username      String        @unique
  image         String?
  // The language chosen in the app. The morning reminders use it, because that job cannot see the browser cookie.
  locale        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  pets          Pet[]
  role          UserRole      @default(OWNER)
  appointments  Appointment[]
  scheduleBlocks ScheduleBlock[] // periods blocked by admin
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  shopOrders    ShopOrder[]
  createdShopOrders ShopOrder[] @relation("ShopOrderCreatedBy")
  stockMovements StockMovement[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Pet {
  id String @id @default(uuid())

  // basic information
  name              String
  species           Species
  sex               Sex
  photoUrl          String?
  color             String?
  breed             String?
  dateOfBirth       DateTime?
  estimatedAgeValue Decimal?
  estimatedAgeUnit  AgeUnit?
  estimatedAgeAt    DateTime?
  lifestyle         Lifestyle?

  // medical information
  spayedNeutered    spayedNeuteredStatus?
  spayedNeuteredAt  DateTime?
  allergies         String?
  medicalConditions String?
  medications       String?
  diet              String?
  previousHistory   String?
  vaccinations      Vaccination[]
  weightRecords     WeightRecord[]
  treatments        Treatment[]
  medicalVisits     MedicalVisit[]
  appointments      Appointment[]
  careReminders     CareReminder[]
  visitFollowUps    VisitFollowUp[]
  documents         MedicalDocument[]
  weights           PetWeight[]

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("pet")
}

enum spayedNeuteredStatus {
  YES
  NO
  UNKNOWN
}

model Treatment {
  id             String          @id @default(uuid())
  type           TreatmentType
  administeredAt DateTime?
  // True when the vet cleared the next due date, so a later pet save does not invent one.
  followUpCleared Boolean        @default(false)
  petId          String
  careReminder   CareReminder?
  pet            Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)

  // Empty for a dose entered from registration or the pet profile.
  medicalVisitId String?
  medicalVisit   MedicalVisit? @relation(fields: [medicalVisitId], references: [id], onDelete: SetNull)

  @@index([petId])
  @@index([medicalVisitId])
  @@map("treatment")
}

model Appointment {
  id              String            @id @default(uuid())
  type            AppointmentType
  startAt         DateTime
  duration        Int // Duration in minutes
  status          AppointmentStatus @default(BOOKED)
  // Services requested for a veterinary visit. Grooming and operations leave this empty.
  services        VisitService[]    @default([])
  // Set only when type is GROOMING. Shower, haircut, or both do not change the two-hour duration.
  groomingService GroomingService?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  medicalVisit MedicalVisit?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, startAt])
  @@index([petId, startAt])
  @@index([status, startAt])
  @@map("appointment")
}

enum AppointmentType {
  VETERINARY_VISIT
  GROOMING
  OPERATION
}

enum VisitService {
  CHECKUP
  VACCINATION
  DEWORMING
  FLEA_TREATMENT
  FOLLOW_UP
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum GroomingService {
  SHOWER
  HAIRCUT
  BOTH
}

enum TreatmentType {
  DEWORMING
  FLEA_TICK
}

enum Species {
  CAT
  DOG
}

enum Sex {
  MALE
  FEMALE
}

enum Lifestyle {
  INDOOR
  OUTDOOR
  HYBRID
}

model Vaccination {
  id             String          @id @default(uuid())
  administeredAt DateTime?
  type           VaccinationType
  // True when the vet cleared the next due date, so a later pet save does not invent one.
  followUpCleared Boolean        @default(false)
  careReminder   CareReminder?
  petId          String
  pet            Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)

  // Empty for a dose entered from registration or the pet profile.
  medicalVisitId String?
  medicalVisit   MedicalVisit? @relation(fields: [medicalVisitId], references: [id], onDelete: SetNull)

  @@index([petId])
  @@index([medicalVisitId])
  @@map("vaccination")
}

model WeightRecord {
  id          String   @id @default(uuid())
  weightGrams Int
  recordedAt  DateTime @default(now())
  petId       String
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@map("weight_record")
}

enum VaccinationType {
  FIRST
  SECOND
  THIRD
  ANNUAL
}

enum UserRole {
  OWNER
  ADMIN
  SECONDARY_ADMIN
}

enum AgeUnit {
  DAYS
  WEEKS
  MONTHS
  YEARS
}

model MedicalVisit {
  id        String   @id @default(uuid())
  visitedAt DateTime
  notes     String?
  // Copied from the booking, or chosen for a walk-in, so the history stays put if the appointment changes.
  type      AppointmentType
  services  VisitService[] @default([])
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  // Empty for a walk-in. One visit note per booking.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  vaccinations Vaccination[]
  treatments   Treatment[]
  followUp     VisitFollowUp?
  weight       PetWeight?

  @@index([petId])
  @@map("medical_visit")
}

// A measured weight. It may belong to one medical visit, or stand alone when recorded from the pet profile.
model PetWeight {
  id         String   @id @default(uuid())
  // Kilograms. Three decimal places keep a weight under 1 kg exact in grams.
  weight     Decimal  @db.Decimal(7, 3)
  recordedAt DateTime
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  medicalVisitId String?       @unique
  medicalVisit   MedicalVisit? @relation(fields: [medicalVisitId], references: [id], onDelete: Cascade)

  @@index([petId, recordedAt])
  @@map("pet_weight")
}

enum ReminderType {
  VACCINATION
  DEWORMING
  FLEA_TREATMENT
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// A dashboard reminder for the vet. It is not part of the pet's medical history and it does not send a notification.
model VisitFollowUp {
  id          String         @id @default(uuid())
  dueOn       DateTime
  notes       String?
  status      FollowUpStatus @default(PENDING)
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime       @default(now())

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  medicalVisitId String?       @unique
  medicalVisit   MedicalVisit? @relation(fields: [medicalVisitId], references: [id], onDelete: Cascade)

  @@index([status, dueOn])
  @@index([petId])
  @@map("visit_follow_up")
}

model ScheduleBlock {
  id        String   @id @default(uuid())
  startAt   DateTime
  endAt     DateTime
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  scope BlockScope

  @@index([startAt, endAt])
  @@map("schedule_block")
}

enum BlockScope {
  CLINIC
  GROOMING
  BOTH
}

// One open follow-up per pet and kind, enforced by care_reminder_one_open_per_kind.
// A row points at a vaccination or a treatment, not both.
model CareReminder {
  id          String       @id @default(uuid())
  kind        ReminderType
  dueAt       DateTime
  completedAt DateTime?
  // True when the vet changed the calculated date. A later dose still replaces it.
  overridden  Boolean      @default(false)
  dose        String?

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  vaccinationId String?      @unique
  vaccination   Vaccination? @relation(fields: [vaccinationId], references: [id], onDelete: Cascade)

  treatmentId String?    @unique
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([petId, kind], map: "care_reminder_one_open_per_kind", where: { completedAt: null })
  @@index([petId, dueAt])
  @@index([dueAt, completedAt])
  @@map("care_reminder")
}

model Notification {
  id        String    @id @default(uuid())
  title     String
  body      String
  readAt    DateTime?
  // Stops a retried booking or a repeated cron run from writing the same notice twice.
  dedupeKey String?   @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notification")
}

model PushSubscription {
  id       String @id @default(uuid())
  endpoint String @unique
  p256dh   String
  auth     String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscription")
}

model ClinicSetting {
  id             String  @id @default("clinic")
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  mapsUrl        String?
  // Kept for older rows. The clinic uses the public phone number for emergencies.
  emergencyPhone String?
  about          String?
  heroTitleEn    String?
  heroTitleAr    String?
  heroBodyEn     String?
  heroBodyAr     String?
  aboutLeadEn    String?
  aboutLeadAr    String?
  aboutBodyEn    String?
  aboutBodyAr    String?
  // Product.price is stored in this currency. USD prices are cents. LBP prices are whole pounds.
  priceCurrency  String  @default("USD")
  // Whole Lebanese pounds equal to one US dollar. The clinic sets this by hand.
  usdRate        Int     @default(89500)

  @@map("clinic_setting")
}

// Homepage pictures chosen in clinic settings. HERO and ABOUT are single slots. GALLERY is the carousel, in position order.
model ClinicPhoto {
  id         String   @id @default(uuid())
  kind       String
  position   Int      @default(0)
  storageKey String   @unique
  captionEn  String   @default("")
  captionAr  String   @default("")
  createdAt  DateTime @default(now())

  @@index([kind, position])
  @@map("clinic_photo")
}

model MedicalDocument {
  id          String   @id @default(uuid())
  title       String
  storedName  String
  contentType String

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([petId])
  @@map("medical_document")
}

model ProductCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  nameAr   String
  position Int       @default(0)
  products Product[]

  @@map("product_category")
}

model Product {
  id            String          @id @default(uuid())
  name          String
  nameAr        String
  description   String?
  descriptionAr String?
  // Minor units of ClinicSetting.priceCurrency. Cents when that is USD, whole pounds when it is LBP.
  price         Int
  stock         Int             @default(0)
  // Available units at or below this number are low stock. Zero is out of stock.
  lowStockAt    Int             @default(2)
  photoUrl      String?
  available     Boolean         @default(true)
  categoryId    String
  category      ProductCategory @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  movements     StockMovement[]

  @@index([categoryId])
  @@map("product")
}

// Staff adjustments to the sellable quantity. Order reservations stay on the order items.
model StockMovement {
  id        String   @id @default(uuid())
  type      String
  delta     Int
  note      String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  staffId   String
  staff     User     @relation(fields: [staffId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@map("stock_movement")
}

enum ShopOrderStatus {
  PENDING
  APPROVED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  REJECTED
  CANCELLED
  FULFILLED
}

model ShopOrder {
  id        String          @id @default(uuid())
  status    ShopOrderStatus @default(PENDING)
  // Payment is arranged with the clinic. This is not an online charge.
  payment          String          @default("CASH")
  fulfillment      String          @default("PICKUP")
  deliveryAddress  String?
  deliveryPhone    String?
  deliveryNote     String?
  // Saved with the order. Later fee changes do not rewrite this sale. Zero for pickup.
  deliveryFee      Int             @default(0)

  // Copied at creation so a later account change does not rewrite the sale.
  customerName  String @default("")
  customerPhone String @default("")

  ownerId String?
  owner   User?  @relation(fields: [ownerId], references: [id])

  // Set when clinic staff record the order. Empty when the customer placed it.
  createdById String?
  createdBy   User?  @relation("ShopOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Empty until the clinic records that cash or Whish was received.
  paidAt DateTime?

  // The currency of the line prices, and the rate used if a conversion was needed. Later rate changes do not rewrite this.
  currency     String @default("LBP")
  exchangeRate Int    @default(89500)

  items   OrderItem[]

  approvedAt       DateTime?
  outForDeliveryAt DateTime?
  readyForPickupAt DateTime?
  completedAt      DateTime?
  rejectedAt       DateTime?
  cancelledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@index([createdById])
  @@index([status])
  @@map("shop_order")
}

model OrderItem {
  id             String    @id @default(uuid())
  quantity       Int
  unitPrice      Int
  orderId        String
  order          ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_item")
}