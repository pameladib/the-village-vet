# Postgres connection used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Direct Postgres connection used for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Secret used to sign sessions.
BETTER_AUTH_SECRET=

# Public origin of the app. Production uses the canonical https address.
BETTER_AUTH_URL=http://localhost:3000

# Site address used for owner invite links.
APP_URL=http://localhost:3000

# Private storage for pet photos and medical documents.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Secret checked by the daily reminder job.
CRON_SECRET=

# Keys for web push. The subject is a contact mailto address.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:clinic@example.com
